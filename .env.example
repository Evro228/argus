# ==============================================================================
# ARGUS // TACTICAL INTELLIGENCE & DEFENSE COCKPIT
# Environment Configuration Template (.env)
# ==============================================================================
# All services operate in OPEN_MODE / OFFLINE by default without mandatory keys.
# Supplying keys unlocks higher rate limits and high-resolution feeds.
# To activate: copy this file to .env or use the in-app "Live Feeds & API Keys" dialog.
# ==============================================================================

# --- 1. NASA FIRMS (Thermal Hotspots & Fire Satellites) ---
# Register free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Used for real-time 375m VIIRS satellite active fire detection.
NASA_FIRMS_MAP_KEY=

# --- 2. OpenSky Network (ADS-B Global Flight Tracking) ---
# Register free account at: https://opensky-network.org/
# Unlocks 4x higher query rates for global airspace monitoring.
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# --- 3. AISStream (Real-time Maritime Fleet Telemetry) ---
# Register free API key at: https://aisstream.io/
# Unlocks raw WebSocket stream of global maritime vessel positions.
AISSTREAM_API_KEY=

# --- 4. Shodan Search Engine (Host & Port Intelligence) ---
# Get API key at: https://account.shodan.io/
# Used for passive asset enrichment without active network probes.
SHODAN_API_KEY=

# --- 5. Ollama Local LLM Host (Air-Gapped AI Assistant) ---
# Default local endpoint for Ollama (Llama 3, Mistral, CodeLlama)
OLLAMA_HOST=http://127.0.0.1:11434

# --- 6. Telegram Security Alerting Bot ---
# Create bot via @BotFather and get chat ID via @userinfobot
TELEGRAM_ALERT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SEVERITY=WARNING

# --- 7. Workstation Security & Host Defaults ---
ARGUS_PORT=8800
ARGUS_HOST=127.0.0.1
ARGUS_STEALTH_MODE=false
