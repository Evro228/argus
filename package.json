{
  "name": "cybersec-studio",
  "version": "1.1.0",
  "description": "All-in-One Cyber Intelligence, Reconnaissance & Defense Operations Cockpit",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron desktop/main.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.cybersec.studio",
    "productName": "CyberSec Studio",
    "files": [
      "desktop/**/*",
      "frontend/**/*",
      "backend/**/*",
      "requirements.txt"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development"
    }
  },
  "author": "Evro228",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  }
}
