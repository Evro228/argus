{
  "name": "argus",
  "version": "1.0.0",
  "description": "ARGUS // Tactical Intelligence & Defense Cockpit",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron desktop/main.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "io.argus.tactical",
    "productName": "ARGUS",
    "asar": false,
    "afterPack": "./scripts/fix-macos-sign.js",
    "directories": {
      "buildResources": "desktop/assets"
    },
    "files": [
      "desktop/**/*",
      "frontend/**/*",
      "backend/**/*",
      "requirements.txt"
    ],
    "mac": {
      "icon": "desktop/assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "desktop/assets/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 200,
          "type": "file"
        },
        {
          "x": 410,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "desktop/assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "author": "Evro228 <evro228@users.noreply.github.com>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  }
}
